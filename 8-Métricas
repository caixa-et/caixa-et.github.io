      `<div class="row"><span class="dot" style="background:var(--teal)"></span><span class="nm">Heredadas de Tinsa</span><span class="vl">${fmt(herR)}</span><span class="pc">${pctC(herR)}</span></div>
       <div class="row"><span class="dot" style="background:var(--orange)"></span><span class="nm">Entrada manual</span><span class="vl">${fmt(entR)}</span><span class="pc">${pctC(entR)}</span></div>
       <div class="row" style="border-top:1px solid var(--line);padding-top:10px;"><span class="dot" style="background:transparent"></span><span class="nm">Total revisiones HUB · ${rangeLabel()}</span><span class="vl">${fmt(tot)}</span><span class="pc">100%</span></div>`;

    const act=rngIdx();
    const cell=(v,i)=>`<td class="num"${act.indexOf(i)<0?' style="opacity:.4"':''}>${fmt(v)}</td>`;
    const hubRow=(name,s,cls)=>{ const rng=act.reduce((a,i)=>a+(s[i]||0),0);
      return `<tr class="${cls||''}"><td>${name}</td>${WK.map((_,i)=>cell(s[i]||0,i)).join('')}<td class="num">${fmt(rng)}</td><td class="num">${pctC(rng)}</td></tr>`; };
    const totWk=WK.map((_,i)=>(her[i]||0)+(ent[i]||0));
    document.getElementById('hubThead').innerHTML=`<tr><th>Origen</th>${WK_LABELS.map(l=>`<th class="num">${l.replace('Sem ','S')}</th>`).join('')}<th class="num">Rango</th><th class="num">% rango</th></tr>`;
    document.getElementById('hubTable').innerHTML=[
      hubRow('Heredadas de Tinsa',her),
      hubRow('Entrada manual',ent),
      hubRow('Total HUB',totWk,'hl'),
    ].join('');
  }

  function renderIncidents(){
    const el=document.getElementById('incGrid'); if(!el) return;
    el.innerHTML=(V.incidencias||[]).map(it=>`
      <div class="incident${it.state==='done'?' done':''}">
        <div class="inc-val">${it.value}${it.unit?` <small>${it.unit}</small>`:''}</div>
        <div class="inc-title">${it.title}</div>
        <div class="inc-desc">${it.desc}</div>
        <span class="inc-status${it.state==='done'?' done':''}">${it.status}</span>
      </div>`).join('');
  }

  function renderAll(){ paintPicker(); renderFeature(); renderKPIs(); renderCharts(); renderIncidents(); }

  // ---------- range picker ----------
  function buildWeekButtons(){
    document.getElementById('rpWeeks').innerHTML = WK_LABELS.map((lbl,i)=>
      `<button data-i="${i}"><b>${lbl}</b><small>${WK_DATES_A[i]}–${WK_DATES_B[i]}</small></button>`).join('');
  }
  function paintPicker(){
    const lo=rngLo(),hi=rngHi(), last=WK.length-1;
    document.querySelectorAll('#rpWeeks button').forEach(b=>{
      const i=+b.dataset.i; b.classList.remove('sel','inrange');
      if(i===lo||i===hi) b.classList.add('sel');
      else if(i>lo&&i<hi) b.classList.add('inrange');
    });
    document.querySelectorAll('#rpPresets button').forEach(b=>{
      b.classList.toggle('active', b.dataset.preset==='all'&&lo===0&&hi===last);
    });
    document.getElementById('rpRange').textContent=rangeLabel();
  }
  function setRange(a,b){ range.a=a; range.b=b; renderAll(); }

  document.getElementById('rpWeeks').addEventListener('click',e=>{
    const b=e.target.closest('button'); if(!b)return; const i=+b.dataset.i;
    if(isSingle()){ setRange(rngLo(), i); }   // extend current single week into a range
    else { setRange(i, i); }                  // collapse back to a single week
  });
  document.getElementById('rpPresets').addEventListener('click',e=>{
    const b=e.target.closest('button'); if(!b)return;
    if(b.dataset.preset==='all') setRange(0, WK.length-1);
  });

  // Carga data.json si está disponible (dashboard alojado); si no, usa los datos embebidos.
  async function init(){
    try{
      const r=await fetch('data.json',{cache:'no-store'});
      if(r.ok){ const j=await r.json(); if(j&&j.oferta) V=j; }
    }catch(e){ /* archivo local (file://) o sin data.json → se usan los datos embebidos */ }
    buildWeeks();
    const last=WK.length-1; range={a:last,b:last}; // por defecto: última semana
    buildWeekButtons();
    renderAll();
  }
  init();
})();
</script>
</body>
</html>
