  // ---------- KPIs ----------
  function heroCard(tag,val,unit,deltaNum,deltaLbl,posUp,bottom){
    let cls='flat',arrow='';
    if(deltaNum!=null){ if(deltaNum>0){cls=posUp?'up':'down';arrow='↑ ';} else if(deltaNum<0){cls=posUp?'down':'up';arrow='↓ ';} }
    return `<div class="kpi"><div class="tag">${tag}</div>
      <div class="val">${val}${unit?`<span class="unit">${unit}</span>`:''}</div>
      <div class="delta ${cls}">${arrow}${deltaLbl}</div>${bottom||''}</div>`;
  }
  function renderKPIs(){
    const o=V.oferta,ca=V.calidad,t=V.tiempo,rv=V.revis;
    const ek=endKey(), bk=beforeKey();
    // stock metrics: snapshot at end of range, delta vs week before range
    const pubC=o.pub[ek], pubP=o.pub[bk];
    const totC=o.total[ek], totP=o.total[bk];
    const muC=ca.muni[ek], muP=ca.muni[bk];
    // % sin municipio (sobre publicadas)
    const muPctC=ca.muni.pct[ek], muPctP=ca.muni.pct[bk], muPctD=muPctC-muPctP;
    const pp=v=>(v>=0?'+':'−')+Math.abs(v).toFixed(2).replace('.',',');
    // automation %: aggregate over the range (sum auto / sum total)
    const arVal=Math.round(sumRange(rv.auto)/sumRange(rv.total)*100);
    const arPrev = bk==='pre'? null : rv.autoRate[bk];
    const arDelta = arPrev==null? null : arVal-arPrev;
    // tiempo: mean over range
    const tc=Math.round(meanRange(t.auto)), red=Math.round((t.pretinsa-tc)/t.pretinsa*100);

    const cards=[
      heroCard('Propiedades en catálogo', fmt(pubC),'', pubC-pubP,
        `${pubC-pubP>=0?'+':''}${fmt(pubC-pubP)} ${beforeLabel()}`, true,
        `<div class="spark">${sparkline(seriesWKP(o.pub),C.teal)}</div>`),
      heroCard('% de automatización', arVal,'%', arDelta,
        arDelta==null?`media del rango (${WK_LABELS[rngLo()]}${isSingle()?'':'–'+WK_LABELS[rngHi()]})`:`${arDelta>=0?'+':''}${arDelta} pp ${beforeLabel()}`, true,
        `<div class="spark">${sparkline(seriesWK(rv.autoRate),C.orange)}</div>`),
      heroCard('% de propiedades sin municipio', muPctC.toFixed(2).replace('.',','),'%', muPctD,
        `${pp(muPctD)} pp ${beforeLabel()}`, false,
        `<div class="spark">${sparkline(seriesWKP(ca.muni.pct),C.lav)}</div>`),
      heroCard('Propiedades en Backoffice', fmt(totC),'', totC-totP,
        `${totC-totP>=0?'+':''}${fmt(totC-totP)} ${beforeLabel()}`, true,
        `<div class="spark">${sparkline(seriesWKP(o.total),C.teal)}</div>`),
      heroCard('Tiempo promedio por publicación', tc,'s', null,
        `antes ${t.pretinsa} s (PreTinsa)`, true,
        `<span class="badge-green">−${red}% con Tinsa</span>`),
      (function(){
        const rt=V.flujo.retir;
        const retC = isSingle()? rt[endKey()] : sumRange(rt);
        const retDelta = (isSingle() && beforeKey()!=='pre') ? retC - rt[beforeKey()] : null;
        return heroCard('Propiedades retiradas', fmt(retC),'', retDelta,
          retDelta==null ? (isSingle()?'retiradas en la semana':`acumulado del rango (${WK_LABELS[rngLo()]}–${WK_LABELS[rngHi()]})`) : `${retDelta>=0?'+':''}${fmt(retDelta)} ${beforeLabel()}`,
          false,
          `<div class="spark">${sparkline(seriesWK(rt),C.grey)}</div>`);
      })(),
    ];
    document.getElementById('kpiGrid').innerHTML=cards.join('');
  }

