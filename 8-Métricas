      {value:"815", title:"Retiradas aún publicadas", desc:"Propiedades marcadas como retiradas que continúan visibles en el catálogo de cliente.", status:"Fix en curso · Qobrix", state:"curso"},
      {value:"N/D", unit:"volumen", title:"Publicadas sin imágenes", desc:"Propiedades publicadas que no muestran imágenes. Volumen pendiente de cuantificar.", status:"Fix en curso · Tinsa", state:"curso"},
    ],
  };
  let V=V_DEFAULT; // se sobrescribe con data.json si está disponible (ver init)




  // Semanas (etiquetas, fechas y orden) vienen de los datos → añadir una semana = solo editar data.json
  let WK=[], WK_LABELS=[], WK_DATES_A=[], WK_DATES_B=[], WKP=[], WKP_LABELS=[];
  function buildWeeks(){
    const wk=(V.weeks&&V.weeks.length)?V.weeks:[];
    WK=wk.map(w=>w.key); WK_LABELS=wk.map(w=>w.label);
    WK_DATES_A=wk.map(w=>w.a); WK_DATES_B=wk.map(w=>w.b);
    WKP=['pre',...WK]; WKP_LABELS=['PreTinsa',...WK_LABELS];
  }
  const seriesWK  = o => WK.map(w=>o[w]);
  const seriesWKP = o => WKP.map(w=>o[w]);

  // ---------- range state ----------
  let range={a:0,b:0}; // se ajusta a la última semana en init()
  const rngLo = ()=>Math.min(range.a,range.b);
  const rngHi = ()=>Math.max(range.a,range.b);
  const rngIdx = ()=>{ const r=[]; for(let i=rngLo();i<=rngHi();i++) r.push(i); return r; };
  const rngKeys = ()=>rngIdx().map(i=>WK[i]);
  const endKey = ()=>WK[rngHi()];
  const beforeKey = ()=>{ const lo=rngLo(); return lo===0?'pre':WK[lo-1]; };
  const beforeLabel = ()=>{ const lo=rngLo(); return lo===0?'vs PreTinsa':('vs '+WK_LABELS[lo-1]); };
  const rangeLabel = ()=>{ const lo=rngLo(),hi=rngHi(); return lo===hi?`${WK_LABELS[lo]} · ${WK_DATES_A[lo]}–${WK_DATES_B[lo]}`:`${WK_DATES_A[lo]} – ${WK_DATES_B[hi]}`; };
  const sumRange = o => rngKeys().reduce((s,k)=>s+(o[k]||0),0);
  const meanRange = o => { const k=rngKeys(); return k.reduce((s,x)=>s+o[x],0)/k.length; };
  const isSingle = ()=>rngLo()===rngHi();

  // ---------- interactive tooltip ----------
  const tt=document.createElement('div'); tt.id='tt'; document.body.appendChild(tt);
  function moveTip(e){
    const el=e.target;
    const d=(el && el.getAttribute) ? el.getAttribute('data-tip') : null;
    if(d){ tt.innerHTML=d; tt.style.display='block';
      let x=e.clientX+14, y=e.clientY+14;
      const w=tt.offsetWidth||160, h=tt.offsetHeight||60;
      if(x+w>window.innerWidth-8) x=e.clientX-w-14;
      if(y+h>window.innerHeight-8) y=e.clientY-h-14;
      tt.style.left=x+'px'; tt.style.top=y+'px';
    } else { tt.style.display='none'; }
  }
  document.addEventListener('mousemove',moveTip,true);
  document.addEventListener('mouseleave',()=>{tt.style.display='none';},true);

  // ---------- SVG helpers ----------
  function svgEl(w,h){ return `<svg viewBox="0 0 ${w} ${h}" style="width:100%;height:auto;display:block;">`; }
  function niceMax(v){ if(v<=0)return 1; const p=Math.pow(10,Math.floor(Math.log10(v))); const n=v/p;
    let m; if(n<=1)m=1;else if(n<=2)m=2;else if(n<=2.5)m=2.5;else if(n<=5)m=5;else m=10; return m*p; }
  function niceScale(lo,hi,ticks){ ticks=ticks||4; if(lo===hi)hi=lo+1;
    const raw=(hi-lo)/ticks, p=Math.pow(10,Math.floor(Math.log10(raw))), n=raw/p;
    let s; if(n<=1)s=1;else if(n<=2)s=2;else if(n<=2.5)s=2.5;else if(n<=5)s=5;else s=10; s*=p;
    return {min:Math.floor(lo/s)*s,max:Math.ceil(hi/s)*s,step:s}; }

  function tip(name,cat,val,pct){ return `data-tip="<b>${name}</b><br><span class='ts'>${cat}</span><br><span class='tv'>${pct?val+'%':fmt(val)}</span>"`; }

  function barChart(el,labels,series,mode,opts){
    opts=opts||{};
    const vbW=680,vbH=opts.height||240,padL=58,padR=12,padT=20,padB=24;
    const plotW=vbW-padL-padR,plotH=vbH-padT-padB;
    let max = mode==='stack'
      ? Math.max.apply(null,labels.map((_,i)=>series.reduce((s,se)=>s+(se.data[i]||0),0)))
      : Math.max.apply(null,series.flatMap(se=>se.data));
    max=niceMax(max*1.05)||1;
    const yT=4; let g=svgEl(vbW,vbH);
    for(let t=0;t<=yT;t++){ const y=padT+plotH-plotH*t/yT, val=max*t/yT;
      g+=`<line class="ax" x1="${padL}" y1="${y}" x2="${vbW-padR}" y2="${y}"/>`;
      g+=`<text class="axlbl" x="${padL-6}" y="${y+3}" text-anchor="end">${opts.pct?Math.round(val)+'%':fmt(val)}</text>`; }
    const n=labels.length, slot=plotW/n, groupW=slot*0.62, barW=mode==='stack'?groupW:groupW/series.length;
    const showLbl=opts.labels!==false;
    const act=opts.activeIdx;
    for(let i=0;i<n;i++){ const cx=padL+slot*i+slot/2;
      const dim=act && act.indexOf(i)<0, op=dim?'0.28':'1', lblOp=dim?'0.35':'1';
      if(mode==='stack'){ let acc=0, tot=0;
        for(const se of series){ const v=se.data[i]||0,h=plotH*(v/max),y=padT+plotH-h-acc;
          g+=`<rect x="${cx-barW/2}" y="${y}" width="${barW}" height="${Math.max(0,h)}" fill="${se.color}" fill-opacity="${op}" rx="2" ${tip(se.name,labels[i],v,opts.pct)}/>`;
          acc+=h; tot+=v; }
        if(showLbl) g+=`<text class="vlbl" x="${cx}" y="${padT+plotH-acc-5}" text-anchor="middle" opacity="${lblOp}">${opts.pct?tot+'%':fmt(tot)}</text>`;
      } else { const sx=cx-groupW/2;
        series.forEach((se,si)=>{ const v=se.data[i]||0,h=plotH*(v/max),y=padT+plotH-h,x=sx+si*barW;
          g+=`<rect x="${x+1}" y="${y}" width="${Math.max(0,barW-2)}" height="${Math.max(0,h)}" fill="${se.color}" fill-opacity="${op}" rx="2" ${tip(se.name,labels[i],v,opts.pct)}/>`;
          if(showLbl && series.length<=2) g+=`<text class="vlbl" x="${x+barW/2}" y="${y-4}" text-anchor="middle" opacity="${lblOp}">${opts.pct?v+'%':fmt(v)}</text>`; }); }
      g+=`<text class="axlbl" x="${cx}" y="${vbH-8}" text-anchor="middle"${dim?' opacity="0.5"':''}>${labels[i]}</text>`; }
    g+='</svg>'; el.innerHTML=g;
  }

  function hbarChart(el,labels,series,opts){
    opts=opts||{};
    const vbW=680,rowH=opts.rowH||60,padL=110,padR=54,padT=8,padB=8;
    const vbH=padT+padB+labels.length*rowH;
    let max=niceMax(Math.max.apply(null,series.flatMap(se=>se.data))*1.05)||1;
    const plotW=vbW-padL-padR,barH=(rowH*0.62)/series.length;
    let g=svgEl(vbW,vbH);
    for(let i=0;i<labels.length;i++){ const y0=padT+rowH*i+rowH*0.19;
      g+=`<text class="axlbl" x="${padL-8}" y="${padT+rowH*i+rowH/2+3}" text-anchor="end" style="font-weight:700;fill:var(--ink)">${labels[i]}</text>`;
      series.forEach((se,si)=>{ const v=se.data[i]||0,w=plotW*(v/max),y=y0+si*barH;
        g+=`<rect x="${padL}" y="${y}" width="${Math.max(0,w)}" height="${barH-2}" fill="${se.color}" rx="2" ${tip(se.name,labels[i],v)}/>`;
        g+=`<text class="vlbl" x="${padL+w+5}" y="${y+barH/2+1}">${fmt(v)}</text>`; }); }
    g+='</svg>'; el.innerHTML=g;
  }

  function lineChart(el,labels,series,opts){
    opts=opts||{};
    const vbW=680,vbH=opts.height||210,padL=58,padR=14,padT=14,padB=24;
    const plotW=vbW-padL-padR,plotH=vbH-padT-padB;
    let all=series.flatMap(se=>se.data),min,max,step;
    if(opts.min!=null&&opts.max!=null){ min=opts.min;max=opts.max;step=(max-min)/4; }
    else { const dmin=Math.min.apply(null,all),dmax=Math.max.apply(null,all);
      const pad=(dmax-dmin||dmax||1)*0.08; const sc=niceScale(dmin-pad,dmax+pad,4); min=sc.min;max=sc.max;step=sc.step; }
    if(min===max)max=min+1;
    const n=labels.length;
    const xAt=i=>padL+(n===1?plotW/2:plotW*i/(n-1));
    const yAt=v=>padT+plotH-plotH*(v-min)/(max-min);
    let g=svgEl(vbW,vbH);
    for(let val=min;val<=max+step*0.001;val+=step){ const y=yAt(val);
      g+=`<line class="ax" x1="${padL}" y1="${y}" x2="${vbW-padR}" y2="${y}"/>`;
      g+=`<text class="axlbl" x="${padL-6}" y="${y+3}" text-anchor="end">${opts.pct?Math.round(val)+'%':fmt(val)}</text>`; }
    for(let i=0;i<n;i++) g+=`<text class="axlbl" x="${xAt(i)}" y="${vbH-8}" text-anchor="middle">${labels[i]}</text>`;
    for(const se of series){ let d='';
      se.data.forEach((v,i)=>{ d+=(i?'L':'M')+xAt(i).toFixed(1)+','+yAt(v).toFixed(1)+' '; });
      if(se.fill){ g+=`<path d="${d}L${xAt(n-1)},${padT+plotH} L${xAt(0)},${padT+plotH} Z" fill="${se.color}" opacity="0.10"/>`; }
      g+=`<path d="${d}" fill="none" stroke="${se.color}" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>`;
      se.data.forEach((v,i)=>{ g+=`<circle cx="${xAt(i).toFixed(1)}" cy="${yAt(v).toFixed(1)}" r="3.4" fill="${se.color}" ${tip(se.name,labels[i],v,opts.pct)}/>`;
        if(opts.labelPts) g+=`<text class="vlbl" x="${xAt(i).toFixed(1)}" y="${(yAt(v)-8).toFixed(1)}" text-anchor="middle">${opts.pct?v+'%':fmt(v)}</text>`; }); }
    g+='</svg>'; el.innerHTML=g;
  }

  function sparkline(data,color){
    const vbW=220,vbH=46,pad=4;
    const lo=Math.min.apply(null,data),hi=Math.max.apply(null,data),rng=(hi-lo)||Math.abs(hi)||1;
    const min=lo-rng*0.18,max=hi+rng*0.18,n=data.length;
    const xAt=i=>pad+(n<=1?(vbW-2*pad)/2:(vbW-2*pad)*i/(n-1));
    const yAt=v=>vbH-pad-(vbH-2*pad)*(v-min)/(max-min||1);
    let d=''; data.forEach((v,i)=>{ d+=(i?'L':'M')+xAt(i).toFixed(1)+','+yAt(v).toFixed(1)+' '; });
    return `<svg viewBox="0 0 ${vbW} ${vbH}" style="width:100%;height:auto;display:block;">
      <path d="${d}L${xAt(n-1).toFixed(1)},${vbH-pad} L${xAt(0).toFixed(1)},${vbH-pad} Z" fill="${color}" opacity="0.12"/>
      <path d="${d}" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
      <circle cx="${xAt(n-1).toFixed(1)}" cy="${yAt(data[n-1]).toFixed(1)}" r="3" fill="${color}"/></svg>`;
  }

  function polar(cx,cy,r,a){ return [cx+r*Math.cos(a), cy+r*Math.sin(a)]; }
  function arcPath(cx,cy,r,a0,a1){ const [x0,y0]=polar(cx,cy,r,a0),[x1,y1]=polar(cx,cy,r,a1);
    const large=(a1-a0)>Math.PI?1:0; return `M${x0.toFixed(2)} ${y0.toFixed(2)} A${r} ${r} 0 ${large} 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`; }
  function donut(el,segments,centerLbl){
    const total=segments.reduce((s,x)=>s+x.value,0)||1;
    const vb=210,cx=105,cy=105,r=74,sw=30;
    let a=-Math.PI/2;
    let g=`<svg viewBox="0 0 ${vb} ${vb}" style="width:100%;max-width:230px;height:auto;display:block;margin:0 auto;">`;
    g+=`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#EFEFF7" stroke-width="${sw}"/>`;
    segments.forEach(s=>{ const frac=s.value/total,a1=a+frac*2*Math.PI;
      const pctTxt=(s.value/total*100).toFixed(1).replace('.',',')+'%';
      if(frac>0.9999) g+=`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${s.color}" stroke-width="${sw}" data-tip="<b>${s.name}</b><br><span class='tv'>${fmt(s.value)}</span> · ${pctTxt}"/>`;
      else g+=`<path d="${arcPath(cx,cy,r,a,a1)}" fill="none" stroke="${s.color}" stroke-width="${sw}" data-tip="<b>${s.name}</b><br><span class='tv'>${fmt(s.value)}</span> · ${pctTxt}"/>`;
      a=a1; });
    g+=`<text x="${cx}" y="${cy-3}" text-anchor="middle" style="font-size:26px;font-weight:800;fill:var(--ink)">${fmt(total)}</text>`;
    g+=`<text x="${cx}" y="${cy+16}" text-anchor="middle" style="font-size:10.5px;font-weight:700;fill:var(--sub)">${centerLbl||''}</text>`;
    g+='</svg>'; el.innerHTML=g;
  }

  // ---------- FEATURE ----------
  function renderFeature(){
    const pub=V.oferta.pub, cur=pub[endKey()], prev=pub[beforeKey()];
    const d=cur-prev;
    document.getElementById('featBig').textContent=fmt(cur);
    document.getElementById('featDelta').innerHTML=`<span class="${d>=0?'up':'down'}">${d>=0?'↑ +':'↓ '}${fmt(d)}</span> propiedades publicadas ${beforeLabel()}`;
    document.getElementById('featSub').textContent=`Catálogo publicado a cierre de ${isSingle()?WK_LABELS[rngHi()]:('la '+WK_LABELS[rngHi()])} · rango ${rangeLabel()}`;
